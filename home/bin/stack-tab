#!/usr/bin/env bash
# New herdr tab that comes up already split top and bottom, so panes stack.
# Optional first argument is the tab label.
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:$HOME/.local/bin:$PATH"

label="${1:-}"

if [ -n "$label" ]; then
  created=$(herdr tab create --label "$label" --focus)
else
  created=$(herdr tab create --focus)
fi

pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')

if [ -z "$pane" ]; then
  echo "could not read the new pane id from herdr" >&2
  printf '%s\n' "$created" >&2
  exit 1
fi

herdr pane split "$pane" --direction down >/dev/null
echo "stacked tab ready"
