#!/usr/bin/env bash
# One word for the overnight run, so a long objective never has to be retyped.
#
#   goodnight              audit every skill against the tool it drives
#   goodnight "objective"  run that objective instead
#   goodnight --dry-run    print the gnhf command and exit
#
# Run it in a real terminal. gnhf draws a full screen view, so through an agent
# or a pipe it renders into a file as escape codes and you see nothing.
#
# Wraps gnhf with the guards an unattended run needs: its own worktree, a token
# ceiling, and a usage limit that pauses the run instead of killing it. Never
# passes --push, so every commit waits for a person.
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:$HOME/.local/bin:$PATH"

repo="$HOME/github/dotfiles"
agent=claude
max_tokens=4000000
rate_limit_wait=2h

# The standing objective: prove each new skill matches the tool it describes.
read -r -d '' audit <<'OBJECTIVE' || true
Test every skill in ~/.claude/skills end to end and fix what is broken. For each
of firstmate, gnhf, treehouse, no-mistakes, lavish, agent-cli and library: run
the real tool, confirm the skill's instructions match what the CLI actually
does, and correct the SKILL.md under ~/github/dotfiles/home/.claude/skills/
wherever they disagree. A skill that names a command or flag the tool does not
have is a defect. Record every failure and its real fix in
~/github/dotfiles/library/, in the format at the bottom of library/INDEX.md.
Do not push. Do not touch staging or main. Follow ~/.claude/CLAUDE.md.
OBJECTIVE

dry_run=0
objective=""

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --dry-run) dry_run=1 ;;
    -*)
      echo "goodnight: unknown flag $arg" >&2
      echo "try: goodnight --help" >&2
      exit 2
      ;;
    *) objective="$arg" ;;
  esac
done

[ -n "$objective" ] || objective="$audit"

if ! command -v gnhf >/dev/null 2>&1; then
  echo "goodnight: gnhf is not on PATH" >&2
  echo "it is deployed by home-manager switch, from home/bin/gnhf" >&2
  exit 1
fi

# The standing objective is about this repo, so run there unless a caller gave
# its own objective and its own directory to run it in.
if [ "$objective" = "$audit" ]; then
  if [ ! -d "$repo/.git" ]; then
    echo "goodnight: $repo is not a git repository" >&2
    exit 1
  fi
  cd "$repo"
fi

set -- gnhf \
  --agent "$agent" \
  --worktree \
  --max-tokens "$max_tokens" \
  --max-rate-limit-wait "$rate_limit_wait" \
  "$objective"

if [ "$dry_run" = 1 ]; then
  printf '%q ' "$@"
  printf '\n'
  exit 0
fi

# The launch card. gnhf takes the alternate screen the moment it starts, so
# this is what you see on the way in and what is still there when it exits.
#
# Colour only when stdout is a terminal that wants it, so a redirect to a file
# or a pipe into a log gets clean text. Values stay ASCII on purpose: the
# padding counts characters, and a locale that is not UTF-8 counts bytes, which
# would knock the right hand border out of line.
dim=''; bold=''; off=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  dim=$'\033[2m'; bold=$'\033[1m'; off=$'\033[0m'
fi

W=62

# Not `printf %*s | tr ' ' '─'`. tr works on bytes, and the box character is
# three of them, so that prints a row of mojibake instead of a line.
rule() { printf '─%.0s' $(seq 1 "$W"); }

edge() { printf '  %s%s%s%s%s\n' "$dim" "$1" "$(rule)" "$2" "$off"; }

# One labelled line. The label is padded before the colour goes on, so the
# escape codes never count towards the width.
kv() {
  local pad=$(( W - 12 - ${#2} ))
  [ "$pad" -lt 0 ] && pad=0
  printf '  %s│%s %s%-10s%s%s%*s %s│%s\n' \
    "$dim" "$off" "$bold" "$1" "$off" "$2" "$pad" '' "$dim" "$off"
}

# The title sits above the box rather than inside it. It carries a moon, and
# terminals disagree about whether an emoji is one column or two, so anything
# padded to a border beside one lines up in some terminals and not others.
# Outside the box there is no border to miss.
echo
printf '  🌙 %s%s%s\n' "$bold" 'g o o d n i g h t' "$off"
printf '     %s%s%s\n' "$dim" 'the agents work, you do not' "$off"
echo
edge '╭' '╮'
kv 'repo'     "$(pwd)"
kv 'agent'    "$agent"
kv 'worktree' 'its own, nothing collides with your open tree'
kv 'ceiling'  "$(( max_tokens / 1000000 ))M tokens, $rate_limit_wait of usage-limit wait"
kv 'push'     'never, every commit waits for you'
edge '├' '┤'
kv 'morning'  'git log --oneline --stat, treehouse status'
edge '╰' '╯'
echo

exec "$@"
