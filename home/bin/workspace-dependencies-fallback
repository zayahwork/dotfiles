#!/usr/bin/env bash
# Verify cached Codex workspace runtimes when the desktop loader returns no paths.
set -euo pipefail

skill_name="${1:-}"
if [[ -z "$skill_name" || ! "$skill_name" =~ ^[a-z0-9-]+$ ]]; then
  echo "usage: workspace-dependencies-fallback <skill-name>" >&2
  exit 2
fi

runtime_root="${CODEX_RUNTIME_ROOT:-$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies}"
python_exec="$runtime_root/python/bin/python3"
node_exec="$runtime_root/node/bin/node"
skill_root="$HOME/.codex/plugins/cache/openai-primary-runtime/$skill_name"

if [[ ! -x "$python_exec" ]]; then
  echo "workspace-dependencies-fallback: missing executable $python_exec" >&2
  exit 1
fi

if [[ ! -x "$node_exec" ]]; then
  echo "workspace-dependencies-fallback: missing executable $node_exec" >&2
  exit 1
fi

if [[ ! -d "$skill_root" ]]; then
  echo "workspace-dependencies-fallback: missing skill root $skill_root" >&2
  exit 1
fi

skill_path="$(find "$skill_root" -type f -path "*/skills/$skill_name/SKILL.md" -print | sort | tail -n 1)"
if [[ -z "$skill_path" || ! -s "$skill_path" ]]; then
  echo "workspace-dependencies-fallback: no nonempty SKILL.md for $skill_name" >&2
  exit 1
fi

python_version="$("$python_exec" --version 2>&1)"
node_version="$("$node_exec" --version 2>&1)"

case "$skill_name" in
  documents) dependency_check="docx" ;;
  pdf) dependency_check="pypdf" ;;
  spreadsheets) dependency_check="openpyxl" ;;
  *) dependency_check="" ;;
esac

dependency_version="not-checked"
if [[ -n "$dependency_check" ]]; then
  dependency_version="$("$python_exec" -c "import $dependency_check; print($dependency_check.__version__)" 2>&1)"
fi

printf 'python=%s\n' "$python_exec"
printf 'python_version=%s\n' "$python_version"
printf 'node=%s\n' "$node_exec"
printf 'node_version=%s\n' "$node_version"
printf 'skill=%s\n' "$skill_path"
printf 'skill_bytes=%s\n' "$(wc -c <"$skill_path" | tr -d ' ')"
printf 'dependency=%s\n' "$dependency_check"
printf 'dependency_version=%s\n' "$dependency_version"
