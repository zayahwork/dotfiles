#!/usr/bin/env python3
"""Convert timezone-free wall-clock components to an Excel 1900 serial."""

from __future__ import annotations

import sys
from datetime import datetime


EPOCH = datetime(1899, 12, 30)


def serial_for(value: str) -> float:
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is not None:
        raise ValueError("timestamp must not include Z or a UTC offset")
    return (parsed - EPOCH).total_seconds() / 86400


def self_test() -> int:
    fixtures = {
        "1970-01-01T00:00:00": 25569.0,
        "2026-10-20T17:46:55": 46315.74091435185,
    }
    failures: list[str] = []
    for source, expected in fixtures.items():
        actual = serial_for(source)
        if actual != expected:
            failures.append(f"{source}: expected {expected!r}, got {actual!r}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1
    print(f"excel-wall-clock-serial: {len(fixtures)} fixtures passed")
    return 0


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        return self_test()
    if len(sys.argv) != 2:
        print(
            "usage: excel-wall-clock-serial 'YYYY-MM-DDTHH:MM:SS[.ffffff]'",
            file=sys.stderr,
        )
        return 2
    try:
        print(repr(serial_for(sys.argv[1])))
    except ValueError as error:
        print(f"excel-wall-clock-serial: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
