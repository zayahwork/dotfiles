#!/usr/bin/env bash
# gh-axi wraps the GitHub CLI in agent ergonomic output: a few fields instead of
# a JSON dump, "0 open" instead of a blank line, structured errors, no prompts.
#
#   gh-axi                      the repo dashboard, no arguments needed
#   gh-axi issue list --state open
#   gh-axi pr view 42
#
# Here because agents shell out to `gh` constantly and pay for its human sized
# output every time. Their published benchmark, 425 runs, has it at 100% task
# success and $0.050 against plain `gh` at 86% and $0.054.
#
# npx rather than npm -g, same as gnhf: a nix node has a read-only global prefix
# and a mutable one would drift from this repo. Pinned, so an upstream release
# cannot quietly change what a switch installs. Bump the version here and
# nowhere else.
#
# Do not run `gh-axi setup hooks`. It writes session hooks into the agent config
# outside this repo, which is exactly the untracked mutable state the npx
# wrapper exists to avoid.
#
# Everything past this wrapper is gh-axi's own interface, --help included.
set -euo pipefail
export PATH="$HOME/.nix-profile/bin:$HOME/.local/bin:$PATH"
exec npx -y gh-axi@0.1.35 "$@"
