# The stream agent's credentials. Names only in this file; it is committed.
#
# The real one is stream/secrets.env, which is gitignored and never leaves the
# Acer. Copy this file to that name and paste values in. `secrets` reads it at
# runtime, refuses to start if a needed key is missing, and names the missing
# one so a typo is loud rather than silent.
#
# Nothing here should ever be pasted into a chat, a commit, or an Actions log.

# --- YouTube --------------------------------------------------------------
# Channel @ZayBuilds-b6o, login zayahnelson97@gmail.com
# Studio -> Go Live -> Stream tab. Needed for P2.
YOUTUBE_INGEST_URL=
YOUTUBE_STREAM_KEY=

# Google Cloud console -> OAuth client. Owner-view analytics: impressions,
# CTR, retention. Needed for P7, not before.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- X --------------------------------------------------------------------
# Two Premium accounts: zayahwork@gmail.com and zayahwork1@gmail.com.
# UNCONFIRMED that RTMP ingest exists for Premium at all. Go live once from
# either account before filling these in. Needed for P9.
X_INGEST_URL_MAIN=
X_STREAM_KEY_MAIN=
X_INGEST_URL_ALT=
X_STREAM_KEY_ALT=

# --- Twitch ---------------------------------------------------------------
# Login zayahwork@gmail.com, not Affiliate or Partner.
# Creator Dashboard -> Settings -> Stream. Needed for P10.
TWITCH_INGEST_URL=
TWITCH_STREAM_KEY=

# --- Kick -----------------------------------------------------------------
# Login zayahwork@gmail.com. Account exists, unconfigured.
# Creator Dashboard -> Stream settings. Needed for P10.
KICK_INGEST_URL=
KICK_STREAM_KEY=

# --- obs-websocket --------------------------------------------------------
# Set in OBS: Tools -> WebSocket Server Settings. Localhost only.
# Needed for P1, which is the first thing that runs.
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
